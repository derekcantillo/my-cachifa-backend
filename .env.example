# ─── App ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_KEY=                         # generate with `openssl rand -hex 32`

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cachifa

# ─── WhatsApp ─────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=
MY_WA_NUMBER=

# ─── AI Provider ─────────────────────────────────────
AI_PROVIDER=gemini               # 'gemini' or 'anthropic'
GEMINI_API_KEY=                  # aistudio.google.com
ANTHROPIC_API_KEY=               # console.anthropic.com (optional if using gemini)
