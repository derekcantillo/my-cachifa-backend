# ─── App ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_KEY=                         # generate with `openssl rand -hex 32`

# ─── Database ─────────────────────────────────────────
# Inside Docker the host is the Postgres container name, not localhost.
DATABASE_URL=postgresql://postgres:password@cachifa_db:5432/cachifa_db
# Only for running prisma/seed + migrate-local from the host. Never set this in
# a production .env — the container would resolve it to its own localhost.
DATABASE_URL_LOCAL=postgresql://postgres:password@localhost:5432/cachifa_db

# Used by docker-compose to initialise the Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cachifa_db

# ─── Cloudflare Tunnel (production only) ──────────────
# Zero Trust → Networks → Tunnels → your tunnel → Docker connector token.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── WhatsApp ─────────────────────────────────────────
# Required by the Joi schema in app.module.ts even while the channel is paused:
# placeholders are fine, but the app will not boot if they are missing.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_WEBHOOK_SECRET=
MY_WA_NUMBER=

# ─── AI Provider ─────────────────────────────────────
AI_PROVIDER=gemini               # 'gemini' or 'anthropic'
GEMINI_API_KEY=                  # aistudio.google.com
ANTHROPIC_API_KEY=               # console.anthropic.com (optional if using gemini)

# ─── pgAdmin (dev only, `--profile tools`) ────────────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
