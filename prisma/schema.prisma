generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Category mapping notes ───────────────────────────────────
//
// Equivalencia entre las categorías del diseño de my-cachifa-mobile y el
// enum `Category` de este schema. El backend es la fuente de verdad: el
// móvil muestra las etiquetas en español, pero persiste y consulta usando
// estos valores del enum.
//
//   Móvil (etiqueta ES)          →  Category
//   ─────────────────────────────────────────────
//   Alimentación                 →  FOOD
//   Mercado                      →  FOOD          (se unifica con Alimentación)
//   Ocio                         →  ENTERTAINMENT
//   Entretenimiento              →  ENTERTAINMENT (se unifica con Ocio)
//   Vivienda                     →  HOUSING       (nuevo en el Bloque 7)
//   Transporte                   →  TRANSPORT
//   Servicios                    →  SERVICES
//   Deuda                        →  DEBT
//   Ahorro                       →  SAVING
//
// Pendiente en el móvil: "Alimentación"/"Mercado" y "Ocio"/"Entretenimiento"
// aparecen como categorías distintas en los datos mock. Deben unificarse a
// una sola etiqueta por valor del enum (sugerido: "Alimentación" y "Ocio y
// Entretenimiento") para que el mapeo sea 1-a-1 en ambos sentidos.
//
// Sin equivalencia declarada en el diseño móvil (existen solo en backend):
// VEHICLE, HEALTH, OTHER. `OTHER` es el destino por defecto de cualquier
// categoría del móvil que no aparezca en esta tabla.
//
// ─── Enums ────────────────────────────────────────────────────

enum Category {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  SERVICES
  DEBT
  SAVING
  VEHICLE
  HEALTH
  HOUSING
  SALARY
  CONTINGENCY
  LOAN
  EDUCATION
  TAXES
  PERSONAL
  OTHER
}

enum TransactionType {
  EXPENSE
  INCOME
  SAVING
  DEBT_PAYMENT
  LOAN_GIVEN
  LOAN_REPAYMENT
  /// Entre dos cuentas propias (`accountId` → `toAccountId`): pago de tarjeta,
  /// avance o mover plata. No es gasto ni ingreso: fuera de ledger,
  /// presupuestos y reportes.
  TRANSFER
  /// Compra a N cuotas con tarjeta (`installmentPlanId`): sube la deuda de la tarjeta
  /// por el monto completo, pero no es gasto. El gasto son las cuotas reconocidas.
  FINANCED_PURCHASE
}

enum LoanStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
}

enum PlanPhase {
  PHASE_1_DEBT_CONTROL
  PHASE_2_OPTIMIZATION
  PHASE_3_VEHICLE_PURCHASE
  PHASE_4_CONSOLIDATION
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

/// `DEBIT_CARD` queda por compatibilidad (Postgres no borra valores de un enum con
/// facilidad), pero la API lo rechaza al crear o editar: una tarjeta débito no es una
/// cuenta, es `hasDebitCard` de una cuenta de ahorros, corriente o billetera.
enum AccountType {
  DEBIT_CARD
  CREDIT_CARD
  CASH
  SAVINGS_ACCOUNT
  CHECKING_ACCOUNT
  DIGITAL_WALLET
}

enum AlertType {
  BUDGET_70
  BUDGET_90
  BUDGET_100
  LARGE_EXPENSE
  SAVING_REMINDER
  WEEKLY_SUMMARY
  MONTHLY_REPORT
  GOAL_PROGRESS
  RECURRING_EXPENSE_DUE
  SAVINGS_TARGET_AT_RISK
  PERIOD_DEFICIT
}

// ─── Models ───────────────────────────────────────────────────

model User {
  id                      String                 @id @default(cuid())
  waNumber                String                 @unique @map("wa_number")
  name                    String?
  /**
   * % del ingreso disponible que se recomienda destinar a ahorro/metas.
   */
  targetSavingsPercentage Decimal                @default(30.00) @map("target_savings_percentage") @db.Decimal(5, 2)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  transactions            Transaction[]
  budgets                 Budget[]
  budgetRules             BudgetRule[]
  goals                   Goal[]
  alerts                  Alert[]
  accounts                Account[]
  recurringExpenses       RecurringExpense[]
  loans                   Loan[]
  periodLedgers           PeriodLedger[]
  financialPeriods        FinancialPeriod[]
  institutions            FinancialInstitution[]
  installmentPlans        InstallmentPlan[]

  @@map("users")
}

model Account {
  id                 String                     @id @default(cuid())
  userId             String                     @map("user_id")
  name               String
  type               AccountType
  /**
   * Saldo del que parte `currentBalance`, para "ponerse al día" sin reconstruir el historial.
   */
  initialBalance     Decimal                    @default(0) @map("initial_balance") @db.Decimal(12, 2)
  /**
   * Desde cuándo aplica `initialBalance`; sin ella, `currentBalance` suma todo el historial.
   */
  initialBalanceDate DateTime?                  @map("initial_balance_date")
  /// Entidad del producto ("Bancolombia"); `null` = sin entidad (efectivo).
  institutionId      String?                    @map("institution_id")
  /// La cuenta tiene tarjeta débito. Es solo un medio de pago: no cambia ningún cálculo.
  hasDebitCard       Boolean                    @default(false) @map("has_debit_card")
  /// Últimos 4 dígitos de la tarjeta (débito de la cuenta, o la tarjeta de crédito).
  cardLast4          String?                    @map("card_last4") @db.VarChar(4)
  /// Cupo total de una `CREDIT_CARD`. Con cupo, la tarjeta está "configurada": su saldo
  /// es −deuda y entra al patrimonio como pasivo. Sin cupo queda fuera de los totales.
  creditLimit        Decimal?                   @map("credit_limit") @db.Decimal(12, 2)
  /// Día de corte (1-31; 31 = último día del mes, se ajusta a meses cortos).
  statementDay       Int?                       @map("statement_day")
  /// Día de pago (1-31) del mes siguiente al corte.
  paymentDueDay      Int?                       @map("payment_due_day")
  /// Tasa mensual por defecto, en % (2.1155 = 2,1155 % mensual). Solo para estimar.
  defaultMonthlyRate Decimal?                   @map("default_monthly_rate") @db.Decimal(7, 4)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `Restrict`: una entidad con productos no se borra (la API responde 400 antes).
  institution        FinancialInstitution?      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  transactions       Transaction[]
  /// Transferencias (`TRANSFER`) que llegan a esta cuenta.
  incomingTransfers  Transaction[]              @relation("TransferDestination")
  loans              Loan[]
  balanceAdjustments AccountBalanceAdjustment[]
  installmentPlans   InstallmentPlan[]

  @@index([userId])
  @@index([institutionId])
  @@map("accounts")
}

enum InstallmentPlanKind {
  /// Compra nueva a cuotas (después del ancla): crea su `FINANCED_PURCHASE`.
  PURCHASE
  /// Ampliación de plazo: reestructura deuda que ya existía. Sin transacción.
  REFINANCE
  /// Compra a cuotas que ya estaba en el extracto (antes del ancla). Sin transacción.
  LEGACY
}

/// `FINISHED` no se guarda: se calcula (todas las cuotas facturadas y reconocidas).
enum InstallmentPlanStatus {
  ACTIVE
  /// Liquidado: el capital restante se reconoció de una vez.
  SETTLED
}

/// Compra o deuda a cuotas de una `CREDIT_CARD` (docs/design-liabilities.md D). La
/// cuota es solo capital (`principal / installmentCount`); los intereses los cobra el
/// extracto y se registran aparte. El calendario se calcula, no se guarda.
model InstallmentPlan {
  id                    String                @id @default(cuid())
  userId                String                @map("user_id")
  /// La tarjeta.
  accountId             String                @map("account_id")
  kind                  InstallmentPlanKind
  description           String
  /// Lo que se compró: también es la categoría de cada cuota reconocida.
  category              Category?
  principal             Decimal               @db.Decimal(12, 2)
  installmentCount      Int                   @map("installment_count")
  /// % mensual, fijo para este plan (cada compra conserva la tasa del día).
  monthlyRate           Decimal               @map("monthly_rate") @db.Decimal(7, 4)
  /// Día de la compra o de la ampliación.
  startDate             DateTime              @map("start_date") @db.Date
  /// Corte que factura la cuota 1 (día de corte de la tarjeta en ese mes).
  firstStatementDate    DateTime              @map("first_statement_date") @db.Date
  /// Cuotas ya pagadas antes de que la app conociera el plan (8 si "va en la 9/24").
  billedBeforeTracking  Int                   @default(0) @map("billed_before_tracking")
  /// Si cada cuota cuenta como gasto del presupuesto en su fecha de pago.
  recognizeInstallments Boolean               @map("recognize_installments")
  status                InstallmentPlanStatus @default(ACTIVE)
  settledAt             DateTime?             @map("settled_at") @db.Date
  /// Cuota con la que se reconoció el capital restante al liquidar (para deshacerlo).
  settlementInstallment Int?                  @map("settlement_installment")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions          Transaction[]

  @@index([userId])
  @@index([accountId])
  @@map("installment_plans")
}

enum BalanceAdjustmentReason {
  /// `POST /accounts/:id/statement-balance`: extracto de tarjeta o saldo del banco.
  STATEMENT
  /// `PATCH /accounts/:id/initial-balance`.
  INITIAL_BALANCE
  /// Deshace otro ajuste (`revertsId`).
  REVERT
}

/// Historial del ancla (`initialBalance` + `initialBalanceDate`) de una cuenta, con los
/// valores anteriores para poder revertir. Nunca toca transacciones.
model AccountBalanceAdjustment {
  id             String                    @id @default(cuid())
  accountId      String                    @map("account_id")
  reason         BalanceAdjustmentReason
  oldAmount      Decimal                   @map("old_amount") @db.Decimal(12, 2)
  oldDate        DateTime?                 @map("old_date")
  newAmount      Decimal                   @map("new_amount") @db.Decimal(12, 2)
  newDate        DateTime?                 @map("new_date")
  /// Cupo antes y después; iguales si el ajuste no lo cambió.
  oldCreditLimit Decimal?                  @map("old_credit_limit") @db.Decimal(12, 2)
  newCreditLimit Decimal?                  @map("new_credit_limit") @db.Decimal(12, 2)
  /// Fecha del extracto o del saldo del banco (día de Bogotá), solo en `STATEMENT`.
  statementDate  DateTime?                 @map("statement_date") @db.Date
  /// `currentBalance` justo antes y justo después del ajuste (foto de ese momento).
  balanceBefore  Decimal                   @map("balance_before") @db.Decimal(12, 2)
  balanceAfter   Decimal                   @map("balance_after") @db.Decimal(12, 2)
  /// En un `REVERT`, el ajuste que deshace.
  revertsId      String?                   @unique @map("reverts_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  account        Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reverts        AccountBalanceAdjustment? @relation("AdjustmentRevert", fields: [revertsId], references: [id], onDelete: SetNull)
  revertedBy     AccountBalanceAdjustment? @relation("AdjustmentRevert")

  @@index([accountId, createdAt])
  @@map("account_balance_adjustments")
}

/// Banco o billetera que agrupa productos (`Account`) en "Mis productos".
model FinancialInstitution {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@unique([userId, name])
  @@map("financial_institutions")
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  accountId          String?           @map("account_id")
  recurringExpenseId String?           @map("recurring_expense_id")
  loanId             String?           @map("loan_id")
  /**
   * Cuenta destino de una `TRANSFER` (`accountId` es el origen). Nulo en
   * cualquier otro tipo.
   */
  toAccountId        String?           @map("to_account_id")
  /**
   * Abono del que nace esta transacción `LOAN_REPAYMENT`. Borrar el abono la
   * borra (cascade); así deshacer un abono no deja el movimiento huérfano.
   */
  loanRepaymentId    String?           @unique @map("loan_repayment_id")
  amount             Decimal           @db.Decimal(12, 2)
  type               TransactionType
  category           Category
  description        String?
  tags               String[]          @default([])
  rawMessage         String            @map("raw_message")
  transactionDate    DateTime          @default(now()) @map("transaction_date")
  /**
   * @deprecated `YYYY-MM` (hora de Bogotá) de `transactionDate`. Ningún
   * cálculo lo lee ya — budgets, ledger y reports agrupan por `periodId`.
   * Se sigue escribiendo solo porque el móvil aún lo lee de la respuesta;
   * retirarlo cuando el móvil deje de hacerlo.
   */
  monthYear          String            @map("month_year")
  /**
   * @deprecated Mes que "cubría" un salario en el modelo de mes calendario.
   * El período de un salario ahora lo define su fecha; ya no se escribe ni
   * se lee en ningún cálculo. Se conserva el histórico y se devuelve en la
   * respuesta por compatibilidad con el móvil.
   */
  budgetPeriod       String?           @map("budget_period")
  /**
   * Período financiero (salario a salario) en cuyo rango cae
   * `transactionDate`. Lo mantiene `FinancialPeriodService`. Es la clave
   * por la que budgets, ledger y reports agrupan las transacciones.
   */
  periodId           String?           @map("period_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  toAccount          Account?          @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  // Un préstamo eliminable (sin repagos) se lleva su Transaction vinculada consigo.
  loan               Loan?             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanRepayment      LoanRepayment?    @relation(fields: [loanRepaymentId], references: [id], onDelete: Cascade)
  period             FinancialPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)
  /// Plan de cuotas: su `FINANCED_PURCHASE` (`installmentNumber = null`) o una cuota
  /// reconocida como gasto. Solo se mantienen desde `/installment-plans`.
  installmentPlanId  String?           @map("installment_plan_id")
  /// Número de la cuota reconocida (1..N); `null` en el `FINANCED_PURCHASE`.
  installmentNumber  Int?              @map("installment_number")
  installmentPlan    InstallmentPlan?  @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, installmentNumber])
  @@index([userId, periodId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([recurringExpenseId])
  @@index([loanId])
  @@map("transactions")
}

/**
 * Presupuesto de una categoría en un período financiero. `spentAmount` es
 * derivado: `BudgetRecalculationService` lo recalcula de las transacciones
 * del período. Se borra con el período (ej. si su salario se elimina).
 */
model Budget {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  periodId    String          @map("period_id")
  category    Category
  limitAmount Decimal         @map("limit_amount") @db.Decimal(12, 2)
  spentAmount Decimal         @default(0) @map("spent_amount") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([userId, periodId, category])
  @@index([periodId])
  @@map("budgets")
}

/**
 * Qué porcentaje de la base del período (`openingBalance + income -
 * compromisos fijos`) se asigna a cada categoría. `recalculateBudgets` la usa
 * para derivar `Budget.limitAmount`.
 */
model BudgetRule {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  category         Category
  targetPercentage Decimal  @map("target_percentage") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budget_rules")
}

/**
 * Un compromiso mensual recurrente (arriendo, suscripciones...). Mientras
 * está `active`, tiene precedencia sobre cualquier `BudgetRule` de la misma
 * categoría: `recalculateBudgets` fija `Budget.limitAmount` en la suma de los
 * `estimatedAmount` activos de esa categoría en vez de derivarlo de un
 * porcentaje.
 */
model RecurringExpense {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  name            String
  category        Category
  estimatedAmount Decimal       @map("estimated_amount") @db.Decimal(12, 2)
  /**
   * Si el monto real varía mes a mes (ej. un servicio) o es siempre igual (ej. arriendo).
   */
  isAmountFixed   Boolean       @default(false) @map("is_amount_fixed")
  dayOfMonth      Int           @map("day_of_month")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([userId])
  @@map("recurring_expenses")
}

model Goal {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  name          String
  targetAmount  Decimal            @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal            @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime           @map("target_date")
  phase         PlanPhase
  status        GoalStatus
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id            String   @id @default(cuid())
  goalId        String   @map("goal_id")
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  contributedAt DateTime @default(now()) @map("contributed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

model Alert {
  id      String    @id @default(cuid())
  userId  String    @map("user_id")
  type    AlertType
  message String
  sentAt  DateTime  @default(now()) @map("sent_at")
  read    Boolean   @default(false)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

/**
 * Dinero prestado a un tercero. No participa en ningún cálculo de
 * presupuesto ni de reporte: la `Transaction` que lo acompaña usa
 * `LOAN_GIVEN`/`LOAN_REPAYMENT`, tipos que `TransactionsService` y
 * `ReportsService` nunca incluyen en sus filtros.
 */
model Loan {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  borrowerName String          @map("borrower_name")
  amount       Decimal         @db.Decimal(12, 2)
  amountRepaid Decimal         @default(0) @map("amount_repaid") @db.Decimal(12, 2)
  status       LoanStatus      @default(ACTIVE)
  loanDate     DateTime        @map("loan_date")
  dueDate      DateTime?       @map("due_date")
  note         String?
  accountId    String?         @map("account_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  repayments   LoanRepayment[]
  transactions Transaction[]

  @@index([userId])
  @@index([accountId])
  @@map("loans")
}

model LoanRepayment {
  id          String       @id @default(cuid())
  loanId      String       @map("loan_id")
  amount      Decimal      @db.Decimal(12, 2)
  paidAt      DateTime     @default(now()) @map("paid_at")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")
  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  /**
   * Su `LOAN_REPAYMENT`; `null` en abonos viejos que no se pudieron emparejar.
   */
  transaction Transaction?

  @@index([loanId])
  @@map("loan_repayments")
}

/**
 * Saldo rodante período a período (estilo YNAB): lo que sobra de un período
 * pasa a ser `openingBalance` del siguiente (por `startDate`). Es un dato
 * derivado — la fuente de verdad siguen siendo `Transaction` y
 * `GoalContribution` — que `PeriodLedgerService.recalculateLedgerCascade`
 * mantiene al día.
 * closingBalance = openingBalance + income - expenses - savings
 */
model PeriodLedger {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  periodId       String          @map("period_id")
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  income         Decimal         @default(0) @db.Decimal(14, 2)
  expenses       Decimal         @default(0) @db.Decimal(14, 2)
  savings        Decimal         @default(0) @db.Decimal(14, 2)
  closingBalance Decimal         @default(0) @map("closing_balance") @db.Decimal(14, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  period         FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([userId, periodId])
  @@index([periodId])
  @@map("period_ledgers")
}

/**
 * Período financiero anclado por el salario: cada `Transaction` INCOME +
 * SALARY abre uno que va desde el día (hora de Bogotá) de ese salario hasta
 * el día anterior al siguiente. El rango es `[startDate, endDate)`:
 * `endDate` es la medianoche en que arranca el siguiente período, así que el
 * último día incluido es `endDate - 1 día`. `endDate = null` es el período
 * abierto actual. Un período sin `anchorTxId` es el "de arranque" que cubre
 * lo registrado antes del primer salario. Es un dato derivado de las
 * transacciones: `FinancialPeriodService.recalculatePeriodsFrom` lo
 * reconstruye.
 */
model FinancialPeriod {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  label        String
  startDate    DateTime       @map("start_date")
  endDate      DateTime?      @map("end_date")
  /**
   * `Transaction` SALARY que abrió el período. Sin FK a propósito: al borrar
   * ese salario, el servicio fusiona el período con el anterior.
   */
  anchorTxId   String?        @map("anchor_tx_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  ledgers      PeriodLedger[]

  @@unique([userId, startDate])
  @@map("financial_periods")
}
